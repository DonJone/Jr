#!/bin/bash

# ==========================================
# Jr CLI Launcher (v3.0.0)
# ==========================================
# Runs compiled release binary, falls back to cargo run or legacy shell core

REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" 2>/dev/null && pwd)"

if [[ -x "$REPO_DIR/target/release/jr" ]]; then
    exec "$REPO_DIR/target/release/jr" "$@"
elif command -v cargo >/dev/null 2>&1; then
    exec cargo run --quiet --release --manifest-path "$REPO_DIR/Cargo.toml" -- "$@"
elif [[ -f "$REPO_DIR/legacy/jr.v2.sh" ]]; then
    exec "$REPO_DIR/legacy/jr.v2.sh" "$@"
else
    echo "Error: jr binary not found. Run 'cargo build --release' or './install.sh'" >&2
    exit 1
fi
